{
  "manifest_version": 3,
  "name": "Crunchyroll Enhancer – CrOptix",
  "version": "3.0.6",
  "description": "Crunchyroll improvements and fixes",
  "homepage_url": "https://github.com/stratumadev/croptix",
  "permissions": [
    "storage",
    "declarativeNetRequest",
    "tabs"
  ],
  "host_permissions": [
    "*://www.crunchyroll.com/*",
    "*://*.crunchyroll.com/*",
    "https://graphql.anilist.co/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "config_init.js",
        "katamari.js",
        "mobile-fix.js",
        "calendar.js",
        "css/*",
        "subtitle-octopus/*",
        "fonts/*"
      ],
      "matches": [
        "*://www.crunchyroll.com/*",
        "*://*.crunchyroll.com/*"
      ]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "{bc118c9c-5c07-4347-b502-657d03d87065}",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ],
        "optional": [
          "browsingActivity",
          "technicalAndInteraction"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "icons": {
    "16": "icons/icon_16x16.png",
    "32": "icons/icon_32x32.png",
    "48": "icons/icon_48x48.png",
    "128": "icons/icon_128x128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon_16x16.png",
      "32": "icons/icon_32x32.png",
      "48": "icons/icon_48x48.png",
      "128": "icons/icon_128x128.png"
    },
    "default_title": "CrOptix"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.crunchyroll.com/*"
      ],
      "js": [
        "crunchyroll.js",
        "subtitle-octopus/subtitles-octopus.js",
        "katamari.js"
      ],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "*://www.crunchyroll.com/*",
        "*://*.crunchyroll.com/*"
      ],
      "js": [
        "calendar.js",
        "content.js"
      ],
      "css": [
        "css/croptix.css",
        "css/croptix-player.css",
        "css/croptix-katamari.css",
        "css/croptix-calendar.css"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}